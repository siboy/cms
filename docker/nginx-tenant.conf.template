# nginx per-tenant (placeholder __SLUG__/__DOMAIN__/__PORT__ diisi scripts/add-tenant.sh).
# Pasang: sudo cp nginx-__SLUG__.conf /etc/nginx/conf.d/  && sudo nginx -t && sudo systemctl reload nginx
# HTTPS:  sudo certbot --nginx -d __DOMAIN__   (certbot menambahkan blok 443 + redirect otomatis)

server {
    listen 80;
    server_name __DOMAIN__;

    client_max_body_size 25m;                     # selaras CMS_UPLOAD_MAX_MB (20) + overhead multipart
    access_log /var/log/nginx/cms-__SLUG__.access.log;
    error_log  /var/log/nginx/cms-__SLUG__.error.log;

    # SSE (realtime): JANGAN dibuffer & beri timeout panjang, selain itu event tertahan di nginx
    location ~ ^/api/docs/[0-9]+/events$ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;   # dipakai app utk rate-limit login/lupa-password per IP
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding off;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
